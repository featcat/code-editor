{
  "name": "@huaanhuang/code-editor",
  "private": false,
  "version": "0.0.1",
  "description": "A powerful React component wrapping Monaco Editor with LSP support and code execution capabilities",
  "keywords": [
    "monaco-editor",
    "code-editor",
    "react",
    "lsp",
    "language-server-protocol",
    "code-runner",
    "typescript",
    "javascript",
    "python",
    "go"
  ],
  "author": "huaanhuang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/featcat/code-editor.git"
  },
  "bugs": {
    "url": "https://github.com/featcat/code-editor/issues"
  },
  "homepage": "https://github.com/featcat/code-editor#readme",
  "type": "module",
  "main": "./dist/code-editor.umd.js",
  "module": "./dist/code-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/code-editor.js",
      "require": "./dist/code-editor.umd.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "*.less"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:lib": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "antd": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "@codingame/monaco-vscode-api": "~2.2.2",
    "@codingame/monaco-vscode-configuration-service-override": "~2.2.2",
    "@codingame/monaco-vscode-editor-api": "~2.2.2",
    "@codingame/monaco-vscode-editor-service-override": "~2.2.2",
    "@codingame/monaco-vscode-files-service-override": "~2.2.2",
    "@codingame/monaco-vscode-go-default-extension": "~2.2.2",
    "@codingame/monaco-vscode-json-default-extension": "~2.2.2",
    "@codingame/monaco-vscode-keybindings-service-override": "~2.2.2",
    "@codingame/monaco-vscode-python-default-extension": "~2.2.2",
    "@codingame/monaco-vscode-rust-default-extension": "~2.2.2",
    "@codingame/monaco-vscode-textmate-service-override": "~2.2.2",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "~2.2.2",
    "@codingame/monaco-vscode-theme-service-override": "~2.2.2",
    "@codingame/monaco-vscode-typescript-basics-default-extension": "~2.2.2",
    "clsx": "^2.1.0",
    "less": "^4.2.0",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@>=2.2.2 <2.3.0",
    "monaco-languageclient": "8.0.0-next.0",
    "vscode": "npm:@codingame/monaco-vscode-api@>=2.2.2 <2.3.0",
    "vscode-languageclient": "~9.0.1",
    "vscode-ws-jsonrpc": "~3.2.0"
  },
  "devDependencies": {
    "@codingame/esbuild-import-meta-url-plugin": "^1.0.3",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "antd": "^5.14.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^4.5.4"
  },
  "overrides": {
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@>=2.2.2 <2.3.0"
  },
  "resolutions": {
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@>=2.2.2 <2.3.0"
  }
}
